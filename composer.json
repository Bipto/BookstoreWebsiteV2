{
    "name": "myapp/bookstore",
    "description": "Bookstore application",
    "type": "project",
    "license": "proprietary",
    "require": {},
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "13.4.8"
    },
    "autoload": {
        "psr-4": {
            "App\\Main\\": "src/sites/main/php/",
            "App\\Admin\\": "src/sites/admin/php/",
            "App\\Api\\": "src/api/php/",
            "App\\Assets\\": "src/sites/assets/php/",
            "App\\Shared\\": "src/shared/php/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --configuration=phpstan.neon",
        "analyse:clear": "phpstan clear-result-cache"
    }
}